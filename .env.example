# Postgres (Neon): usar a connection string "pooled" com sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# gerar com: openssl rand -base64 32
AUTH_SECRET=""
# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Email que fica administrador no primeiro login
ADMIN_EMAIL="paulo.martins.silva@gmail.com"
# Modo de desenvolvimento sem Google: permite login local com qualquer email (nunca em produção)
# AUTH_DEV_LOGIN="true"
