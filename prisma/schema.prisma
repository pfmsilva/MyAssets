generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum AssetType {
  CURRENT_ACCOUNT
  PPR
  BROKERAGE
  CRYPTO
  CASH
  OTHER
}

enum SnapshotSource {
  MANUAL
  IMPORT
  DERIVED
}

enum CategoryKind {
  EXPENSE
  INCOME
  TRANSFER
  INVESTMENT
}

enum TransactionStatus {
  COMPLETED
  PENDING
}

// ---------- Auth (next-auth) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(VIEWER)
  visibleMembers Member[] @relation("UserVisibleMembers")
  accounts      Account[]
  sessions      Session[]
  importBatches ImportBatch[]
  activities    ActivityLog[]
  createdAt     DateTime  @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Family & assets ----------

model Member {
  id         String           @id @default(cuid())
  name       String
  color      String           @default("#2a78d6")
  sortOrder  Int              @default(0)
  viewers    User[]           @relation("UserVisibleMembers")
  ownerships AssetOwnership[]
  createdAt  DateTime         @default(now())
}

model Asset {
  id           String           @id @default(cuid())
  name         String
  institution  String
  type         AssetType
  currency     String           @default("EUR")
  importer     String?          // bpi | revolut | degiro
  active       Boolean          @default(true)
  sortOrder    Int              @default(0)
  ownerships   AssetOwnership[]
  snapshots    Snapshot[]
  transactions Transaction[]
  importBatches ImportBatch[]
  realizedTrades RealizedTrade[]
  createdAt    DateTime         @default(now())
}

model AssetOwnership {
  assetId  String
  memberId String
  percent  Float  @default(100)
  asset    Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([assetId, memberId])
}

model Snapshot {
  id            String         @id @default(cuid())
  assetId       String
  date          DateTime       @db.Date
  value         Float
  source        SnapshotSource @default(MANUAL)
  note          String?
  importBatchId String?
  asset         Asset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  importBatch   ImportBatch?   @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  positions     Position[]
  createdAt     DateTime       @default(now())

  @@unique([assetId, date])
  @@index([date])
}

model Position {
  id         String   @id @default(cuid())
  snapshotId String
  name       String
  isin       String?
  quantity   Float?
  price      Float?
  currency   String   @default("EUR")
  value      Float?
  valueEur   Float
  avgPrice   Float?   // average purchase price in the instrument currency
  costEur    Float?   // acquisition cost in EUR (value - unrealised profit)
  snapshot   Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
}

/// Realised gains/losses (closed positions), e.g. from the XTB "Closed Positions" sheet.
model RealizedTrade {
  id            String       @id @default(cuid())
  assetId       String
  externalId    String
  name          String
  ticker        String?
  quantity      Float?
  openPrice     Float?
  closePrice    Float?
  openTime      DateTime?
  closeTime     DateTime
  profitEur     Float
  grossEur      Float?
  commission    Float?
  importBatchId String?
  asset         Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@unique([assetId, externalId])
  @@index([assetId, closeTime])
}

model Category {
  id           String         @id @default(cuid())
  name         String         @unique
  kind         CategoryKind
  color        String         @default("#2a78d6")
  sortOrder    Int            @default(0)
  rules        CategoryRule[]
  transactions Transaction[]
  budget       Budget?
}

model CategoryRule {
  id         String   @id @default(cuid())
  pattern    String
  priority   Int      @default(0)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Transaction {
  id            String            @id @default(cuid())
  assetId       String
  date          DateTime          @db.Date
  valueDate     DateTime?         @db.Date
  seq           Int               @default(0)
  description   String
  amount        Float
  fee           Float             @default(0)
  balanceAfter  Float?
  kind          String?
  status        TransactionStatus @default(COMPLETED)
  hash          String
  categoryId    String?
  note          String?
  importBatchId String?
  asset         Asset             @relation(fields: [assetId], references: [id], onDelete: Cascade)
  category      Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  importBatch   ImportBatch?      @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())

  @@unique([assetId, hash])
  @@index([assetId, date])
  @@index([date])
  @@index([categoryId])
}

model ImportBatch {
  id           String        @id @default(cuid())
  assetId      String
  source       String
  fileName     String
  rowsTotal    Int           @default(0)
  rowsNew      Int           @default(0)
  userId       String?
  asset        Asset         @relation(fields: [assetId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  snapshots    Snapshot[]
  transactions Transaction[]
  realizedTrades RealizedTrade[]
  createdAt    DateTime      @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  userId    String?
  userEmail String
  userName  String?
  action    String
  entity    String?
  entityId  String?
  details   Json?
  ip        String?
  userAgent String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userEmail, createdAt])
  @@index([action, createdAt])
}

/// Maps a position key (ISIN from DEGIRO, ticker from XTB) to a Yahoo Finance symbol.
model Instrument {
  id         String    @id @default(cuid())
  key        String    @unique
  name       String
  symbol     String?
  manual     Boolean   @default(false)
  lastError  String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

/// Cached market quote (also FX pairs such as USDEUR=X).
model Quote {
  symbol        String    @id
  price         Float
  currency      String
  previousClose Float?
  change        Float?
  changePercent Float?
  marketTime    DateTime?
  shortName     String?
  exchange      String?
  fetchedAt     DateTime
}

/// Monthly spending limit for an expense category.
model Budget {
  id           String   @id @default(cuid())
  categoryId   String   @unique
  monthlyLimit Float
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Key/value application settings (edited in Administração → Definições).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Remembers alerts already sent so the daily job does not repeat them.
model AlertSent {
  key    String   @id
  sentAt DateTime @default(now())
}
